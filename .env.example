# Copy to .env and fill in. Never commit real secrets.

# development | test | production
APP_ENV=development
# Signs login tokens. Production refuses to start unless this is a random 32+ char string:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=replace_me
# Development only: accept the X-Dev-User-Email header instead of a login (never in production).
AUTH_DEV_BYPASS=false
ACCESS_TOKEN_MINUTES=60
# Browser origins allowed to call the API directly (the Docker frontend uses same-origin /api).
CORS_ORIGINS=["http://localhost:5173"]
RATE_LIMIT_LESSONS_PER_HOUR=20
RATE_LIMIT_LOGINS_PER_15MIN=10

# PostgreSQL in Docker Compose. For local runs without Docker you can use
# sqlite:///./data/chesscoach.db (development only; production must use PostgreSQL).
DATABASE_URL=postgresql+psycopg://chesscoach:chesscoach@db:5432/chesscoach

# Path to the Stockfish binary. In Docker this is installed in the worker image.
# Windows example: D:/chess/stockfish-windows-x86-64-avx2/stockfish/stockfish-windows-x86-64-avx2.exe
STOCKFISH_PATH=/usr/local/bin/stockfish
STOCKFISH_DEPTH=16
STOCKFISH_CRITICAL_DEPTH=22
ANALYSIS_MULTIPV=2
ANALYSIS_CRITICAL_WP_LOSS=0.10
ANALYSIS_MAX_ATTEMPTS=3
WORKER_POLL_SECONDS=2
# Keep 1 for reproducible research runs: multi-threaded search is non-deterministic.
STOCKFISH_THREADS=1
STOCKFISH_HASH_MB=512

# LLM coaching (Phase 6). Off by default: lessons then use the deterministic template.
LLM_ENABLED=false
# anthropic | openai_compatible
LLM_PROVIDER=anthropic
# Anthropic: leave empty to use ANTHROPIC_API_KEY or an `ant auth login` profile.
LLM_API_KEY=
# Required for openai_compatible, e.g. https://host/v1
LLM_BASE_URL=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium
LLM_TIMEOUT_SECONDS=120

# Upload storage. Files are stored by SHA-256, never by user-supplied name.
STORAGE_DIR=./data/uploads
PGN_MAX_UPLOAD_MB=25

ANALYSIS_MAX_CONCURRENT_GAMES=2
LOG_LEVEL=INFO
